# ============================================================================
# SCREENARTS ERP - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Instructions:
# 1. Copy this file to .env in your root directory.
# 2. Replace the values below with your Supabase Project URL and Anon/Publishable Key
#    found in your Supabase Dashboard under Settings -> API.
# 3. For Vercel deployment, add these 2 keys under Project Settings -> Environment Variables.
# ============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
